{
  "permissions": {
    "allow": [
      "Bash(uv run python -m tools.check*)",
      "Bash(uv run tools/check.py*)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python -m tools.kernel_timing*)",
      "Bash(uv sync)",
      "Bash(npm --prefix web run *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(uv pip install *)",
      "Bash(pip install *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-python.sh",
            "timeout": 30,
            "statusMessage": "ruff format + fix"
          }
        ]
      }
    ]
  }
}
