{
  "name": "bench-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "generate": "node scripts/copy-pyodide.mjs && node scripts/copy-manifold.mjs && node scripts/bundle-py.mjs",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/keep-runtime-times.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src/components && lit-analyzer \"src/components/**/*.ts\" --strict",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "lit": "^3.3.3",
    "manifold-3d": "3.5.3",
    "pyodide": "315.0.0-alpha.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.0"
  }
}
